      "策略": "其他"
    }
  },
  "分层决策逻辑": [
    {
      "步骤": 1,
      "说明": "模型输出校准概率 prob"
    },
    {
      "步骤": 2,
      "说明": "计算逾期标志 = sum(f31,f42,f53,f64,f74) > 0"
    },
    {
      "步骤": 3,
      "说明": "若逾期标志 >= 2 → 直接拒绝（硬规则优先）"
    },
    {
      "步骤": 4,
      "说明": "若逾期标志 == 1 → 灰名单（人工审核）"
    },
    {
      "步骤": 5,
      "说明": "若逾期标志 == 0 → 按概率规则决策（<0.14通过, 0.14-0.30灰名单, >=0.30拒绝）"
    }
  ],
  "最优组合指标": {
    "规则": "逾期>=1 → 灰名单",
    "F2": 0.5635,
    "Recall": 0.804,
    "说明": "在验证集上F2=0.5635为最优规则组合"
  }
