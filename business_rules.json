{
  "模型名称": "RandomForestClassifier (信贷违约预测)",
  "模型文件": "best_risk_model_calibrated.joblib",
  "阈值": 0.14,
  "说明": "概率由校准模型输出(Isotonic)，阈值0.14经F2扫描选定",
  "概率规则": {
    "通过": {
      "条件": "prob < 0.14",
      "动作": "自动通过",
      "颜色": "green"
    },
    "灰名单": {
      "条件": "0.14 <= prob < 0.30",
      "动作": "人工审核",
      "颜色": "yellow"
    },
    "拒绝": {
      "条件": "prob >= 0.30",
      "动作": "拒绝申请",
      "颜色": "red"
    }
  },
  "特征规则": {
    "逾期标志": {
      "特征列": [
        "f31",
        "f42",
        "f53",
        "f64",
        "f74"
      ],
      "说明": "5个月还款状态逾期2期标志，任一为1即计逾期",
      "合并方式": "sum(特征列) > 0 → 逾期标志=1",
      "规则": [
        {
          "条件": "逾期标志 == 0",
          "动作": "无逾期记录",
          "影响": "无"
        },
        {
          "条件": "逾期标志 == 1",
          "动作": "灰名单(人工审核)",
          "影响": "风险升高，需人工复核"
        },
        {
          "条件": "逾期标志 >= 2",
          "动作": "硬规则拒绝",
          "影响": "多月逾期，直接拒绝"
        }
      ]
    }
  },
  "核心特征方向": {
    "f31": {
      "含义": "2005年9月还款状态=逾期2月",
      "方向": "值越大风险越高",
      "类型": "二值",
      "策略": "硬规则"
    },
    "f0": {
      "含义": "信用额度(新台币,标准化)",
      "方向": "值越小风险越高",
      "类型": "连续",
      "策略": "灰名单标准"
    },
    "f29": {
      "含义": "2005年9月还款状态=按时还款",
      "方向": "值越小风险越高",
      "类型": "二值",
      "策略": "灰名单标准"
    },
    "f42": {
      "含义": "2005年8月还款状态=逾期2月",
      "方向": "值越大风险越高",
      "类型": "二值",
      "策略": "灰名单标准"
    },
    "f8": {
      "含义": "2005年9月还款金额(新台币,标准化)",
      "方向": "值越小风险越高",
      "类型": "连续",
      "策略": "灰名单标准"
    },
    "f64": {
      "含义": "2005年6月还款状态=逾期2月",
      "方向": "值越大风险越高",
